@page "/spots/create"
@page "/spots/{id}/edit"
@inject DataService dataService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="d-flex justify-content-end mb-3">
    <div class="d-flex align-items-center">
        <label class="me-2 fw-bold">@IdiomaLabel:</label>
        <select class="form-select form-select-sm w-auto" @onchange="ChangeLanguage">
            <option value="es">Castellano</option>
            <option value="eu">Euskera</option>
        </select>
    </div>
</div>

<h3 class="mb-4 text-center">@TitleLabel</h3>

@if (showError)
{
    <div class="alert alert-danger">@ErrorLabel</div>
}

<div class="container pb-5">
    <form>
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label">@NameLabel</label>
                    <input class="form-control" @bind="spot.name" placeholder="@NamePlaceholder" />
                </div>

                <div class="mb-3">
                    <label class="form-label">@CountryLabel</label>
                    <select class="form-select" @bind="spot.countryId">
                        <option value="0">@SelectCountryLabel</option>
                        @foreach (var c in dataService.Data.countries)
                        {
                            <option value="@c.id">@c.name</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">@CategoryLabel</label>
                    <select class="form-select" @bind="spot.categoryId">
                        <option value="0">@SelectCategoryLabel</option>
                        @foreach (var c in dataService.Data.categories)
                        {
                            <option value="@c.id">@c.name</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">@CityLabel</label>
                    <input class="form-control" @bind="spot.city" placeholder="@CityPlaceholder" />
                </div>

                <div class="mb-3">
                    <label class="form-label">@RatingLabel</label>
                    <input type="number" min="1" max="5" class="form-control" @bind="spot.rating" />
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label">@MapInstructionLabel</label>
                <div id="map" style="height: 300px; width: 100%; border-radius: 8px; border: 1px solid #ced4da;" class="mb-3"></div>

                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="form-label">@LatLabel</label>
                        <input type="number" step="any" class="form-control" @bind="spot.lat" />
                    </div>
                    <div class="col-6 mb-3">
                        <label class="form-label">@LngLabel</label>
                        <input type="number" step="any" class="form-control" @bind="spot.lng" />
                    </div>
                </div>
            </div>
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
            <button type="button" class="btn btn-secondary me-md-2" @onclick="GoBack">@CancelLabel</button>
            <button type="button" class="btn btn-success" @onclick="SaveSpot">@SaveLabel</button>
        </div>
    </form>
</div>

@code {
    [Parameter]
    public string? id { get; set; }

    private Spot spot = new Spot { rating = 1 };
    private bool isEditMode;
    private bool showError = false;
    private DotNetObjectReference<SpotForm>? dotNetRef;

    private string SelectedLanguage = "es";

    private string IdiomaLabel => SelectedLanguage switch { "eu" => "Hizkuntza", _ => "Idioma" };
    private string TitleLabel => SelectedLanguage switch { "eu" => isEditMode ? "Spot Editatu" : "Spot Sortu", _ => isEditMode ? "Editar Spot" : "Crear Spot" };
    private string ErrorLabel => SelectedLanguage switch { "eu" => "Nahitaezko eremu guztiak ondo bete behar dira.", _ => "Todos los campos obligatorios deben rellenarse correctamente." };
    private string NameLabel => SelectedLanguage switch { "eu" => "Izena", _ => "Nombre" };
    private string NamePlaceholder => SelectedLanguage switch { "eu" => "Sartu izena...", _ => "Introduce el nombre..." };
    private string CountryLabel => SelectedLanguage switch { "eu" => "Herrialdea", _ => "País" };
    private string SelectCountryLabel => SelectedLanguage switch { "eu" => "Aukeratu herrialdea...", _ => "Selecciona un país..." };
    private string CategoryLabel => SelectedLanguage switch { "eu" => "Kategoria", _ => "Categoría" };
    private string SelectCategoryLabel => SelectedLanguage switch { "eu" => "Aukeratu kategoria...", _ => "Selecciona una categoría..." };
    private string CityLabel => SelectedLanguage switch { "eu" => "Hiria", _ => "Ciudad" };
    private string CityPlaceholder => SelectedLanguage switch { "eu" => "Sartu hiria...", _ => "Introduce la ciudad..." };
    private string RatingLabel => SelectedLanguage switch { "eu" => "Rating", _ => "Valoración" };
    private string LatLabel => SelectedLanguage switch { "eu" => "Latitudea (Lat)", _ => "Latitud (Lat)" };
    private string LngLabel => SelectedLanguage switch { "eu" => "Longitudea (Lng)", _ => "Longitud (Lng)" };
    private string CancelLabel => SelectedLanguage switch { "eu" => "Utzi", _ => "Cancelar" };
    private string SaveLabel => SelectedLanguage switch { "eu" => "Gorde", _ => "Guardar" };
    private string MapInstructionLabel => SelectedLanguage switch { "eu" => "Egin klik mapan koordenatuak lortzeko:", _ => "Haz clic en el mapa para obtener coordenadas:" };

    private void ChangeLanguage(ChangeEventArgs e)
    {
        if (e.Value != null)
        {
            SelectedLanguage = e.Value.ToString() ?? "es";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        dotNetRef = DotNetObjectReference.Create(this);
        if (dataService.Data.countries.Count == 0)
        {
            await dataService.InitializeAsync();
        }
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(id))
        {
            isEditMode = true;
            var existingSpot = dataService.Data.spots.FirstOrDefault(s => s.id == id);

            if (existingSpot != null)
            {
                spot = new Spot
                {
                    id = existingSpot.id,
                    name = existingSpot.name,
                    categoryId = existingSpot.categoryId,
                    countryId = existingSpot.countryId,
                    city = existingSpot.city,
                    rating = existingSpot.rating,
                    lat = existingSpot.lat,
                    lng = existingSpot.lng
                };
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(100);
            await JS.InvokeVoidAsync("leafletMap.init", "map", dotNetRef, spot.lat, spot.lng);
        }
    }

    [JSInvokable]
    public void UpdateCoordinates(double lat, double lng)
    {
        spot.lat = lat;
        spot.lng = lng;
        StateHasChanged();
    }

    private async Task SaveSpot()
    {
        showError = false;

        if (string.IsNullOrWhiteSpace(spot.name) ||
            string.IsNullOrWhiteSpace(spot.city) ||
            spot.countryId <= 0 ||
            spot.categoryId <= 0 ||
            spot.rating < 1 || spot.rating > 5)
        {
            showError = true;
            return;
        }

        if (isEditMode)
        {
            var index = dataService.Data.spots.FindIndex(s => s.id == spot.id);
            if (index >= 0)
            {
                dataService.Data.spots[index] = spot;
            }
        }
        else
        {
            int maxId = dataService.Data.spots.Any() ? dataService.Data.spots.Max(s => int.Parse(s.id ?? "0")) : 0;
            spot.id = (maxId + 1).ToString();
            dataService.Data.spots.Add(spot);
        }

        await dataService.SaveDataAsync();
        Navigation.NavigateTo("/spots");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/spots");
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }
}