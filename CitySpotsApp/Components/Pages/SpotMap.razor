@page "/map"
@inject DataService dataService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<div class="d-flex justify-content-end mb-3">
    <div class="d-flex align-items-center">
        <label class="me-2 fw-bold">@IdiomaLabel:</label>
        <select class="form-select form-select-sm w-auto" @onchange="ChangeLanguage">
            <option value="es">Castellano</option>
            <option value="eu">Euskera</option>
        </select>
    </div>
</div>

<h3 class="mb-4 text-center">@TitleLabel</h3>

@if (dataService.Data.spots == null || !dataService.Data.spots.Any())
{
    <div class="alert alert-info">@EmptyLabel</div>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="card-body p-0">
            <div id="generalMap" style="height: 500px; width: 100%; border-radius: 8px;"></div>
        </div>
    </div>

    <h5 class="mb-3">@MarkersLabel</h5>
    <div class="row">
        @foreach (var spot in dataService.Data.spots)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">@spot.name</h6>
                        <p class="card-text small mb-1"><strong>@CategoryLabel:</strong> @GetCategoryName(spot.categoryId)</p>
                        <p class="card-text small mb-3"><strong>@RatingLabel:</strong> @spot.rating / 5</p>
                        <button class="btn btn-outline-primary btn-sm w-100" @onclick="() => GoToSpot(spot.id)">@DetailBtnLabel</button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private string SelectedLanguage = "es";
    private DotNetObjectReference<SpotMap>? dotNetRef;

    private string IdiomaLabel => SelectedLanguage switch { "eu" => "Hizkuntza", _ => "Idioma" };
    private string TitleLabel => SelectedLanguage switch { "eu" => "Spoten Mapa", _ => "Mapa de Spots" };
    private string EmptyLabel => SelectedLanguage switch { "eu" => "Ez dago spotik erakusteko...", _ => "No hay spots para mostrar..." };
    private string MarkersLabel => SelectedLanguage switch { "eu" => "Markatzaile Erabilgarriak:", _ => "Marcadores Disponibles:" };
    private string CategoryLabel => SelectedLanguage switch { "eu" => "Kategoria", _ => "Categoría" };
    private string RatingLabel => SelectedLanguage switch { "eu" => "Rating", _ => "Valoración" };
    private string DetailBtnLabel => SelectedLanguage switch { "eu" => "Xehetasunak Ikusi", _ => "Ver Detalle" };

    private void ChangeLanguage(ChangeEventArgs e)
    {
        if (e.Value != null)
        {
            SelectedLanguage = e.Value.ToString() ?? "es";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        dotNetRef = DotNetObjectReference.Create(this);
        if (dataService.Data.countries.Count == 0)
        {
            await dataService.InitializeAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && dataService.Data.spots != null && dataService.Data.spots.Any())
        {
            await Task.Delay(150);
            await JS.InvokeVoidAsync("leafletMap.initGeneralMap", "generalMap", dotNetRef, dataService.Data.spots);
        }
    }

    [JSInvokable]
    public void NavigateToDetail(string id)
    {
        Navigation.NavigateTo($"/spots/{id}");
    }

    private string GetCategoryName(int cid) => dataService.Data.categories.FirstOrDefault(c => c.id == cid.ToString())?.name ?? "";

    private void GoToSpot(string? id)
    {
        if (!string.IsNullOrEmpty(id))
        {
            Navigation.NavigateTo($"/spots/{id}");
        }
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }
}